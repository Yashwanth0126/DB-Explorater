# ---- App ----
APP_NAME=Credential Rotation System
ENV=development

# ---- Control DB ----
# Local dev (SQLite) - just leave this as-is
DATABASE_URL=sqlite:///./credential_rotation.db

# When you move to cloud Postgres, replace with something like:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Security ----
# JWT signing secret - generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Fernet key used to encrypt stored credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# ---- Default admin user (created on first startup if not present) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_please
ADMIN_EMAIL=admin@example.com

# ---- Scheduler ----
# How often (minutes) the expiry-check job runs
SCHEDULER_INTERVAL_MINUTES=60

# ---- Notifications (Resend HTTP API — https://resend.com) ----
# Sign up free at https://resend.com (no card needed), then create an API key
# under Dashboard -> API Keys. Free tier: 3,000 emails/month, 100/day.
RESEND_API_KEY=re_your_api_key_here
# For testing you can leave this as-is (Resend's shared test sender, only
# delivers to your own verified account email). To send to any address,
# verify your own domain in Resend and use an address on that domain instead.
NOTIFICATION_FROM_EMAIL=onboarding@resend.dev
NOTIFICATION_FROM_NAME=Credential Rotation System
# If not configured, notifications are just logged instead of emailed
NOTIFICATIONS_ENABLED=false
