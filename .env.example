# ---- App ----
APP_NAME=Credential Rotation System
ENV=development

# ---- Control DB ----
# Local dev (SQLite) - just leave this as-is
DATABASE_URL=sqlite:///./credential_rotation.db

# When you move to cloud Postgres, replace with something like:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Security ----
# JWT signing secret - generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Fernet key used to encrypt stored credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# ---- Default admin user (created on first startup if not present) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_please
ADMIN_EMAIL=admin@example.com

# ---- Scheduler ----
# How often (minutes) the expiry-check job runs
SCHEDULER_INTERVAL_MINUTES=60

# ---- SMTP / Notifications ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true
# If not configured, notifications are just logged instead of emailed
NOTIFICATIONS_ENABLED=false
